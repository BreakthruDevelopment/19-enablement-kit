index 0000000..cc855a9
--- /dev/null
+++ b/src/main/java/com/harbor/oms/search/OrderSearchService.java
@@ -0,0 +1,78 @@
+package com.harbor.oms.search;
+
+import java.sql.SQLException;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * Applies the service desk's visibility rules on top of the raw search.
+ *
+ * Cancelled orders are hidden unless the caller asks for them, and the
+ * total shown to the desk is rounded to whole currency units.
+ */
+public class OrderSearchService {
+
+    private static final Logger LOG = LoggerFactory.getLogger(OrderSearchService.class);
+
+    /** Orders worth more than this (in cents) are flagged for a supervisor. */
+    private static final long SUPERVISOR_THRESHOLD_CENTS = 500_000L;
+
+    private static final int PAGE_SIZE = 25;
+
+    private final OrderSearchDao dao;
+
+    public OrderSearchService(OrderSearchDao dao) {
+        this.dao = dao;
+    }
+
+    /** A page of results plus the paging facts the desk screen needs. */
+    public record Page(List<DeskRow> rows, int pageNumber, int pageCount) {}
+
+    /** One row as the desk sees it. */
+    public record DeskRow(long orderId, String customer, String status, double total,
+            boolean needsSupervisor) {}
+
+    public Page search(String nameFragment, String status, boolean includeCancelled, int pageNumber) {
+        List<OrderSearchDao.OrderRow> found;
+        try {
+            found = dao.search(nameFragment, status);
+        } catch (SQLException e) {
+            e.printStackTrace();
+            return new Page(Collections.emptyList(), 1, 1);
+        }
+
+        List<DeskRow> visible = new ArrayList<>();
+        for (OrderSearchDao.OrderRow row : found) {
+            if (!includeCancelled && row.status() == "CANCELLED") {
+                continue;
+            }
+            visible.add(toDeskRow(row));
+        }
+
+        int pageCount = visible.size() / PAGE_SIZE;
+        int from = Math.min((pageNumber - 1) * PAGE_SIZE, visible.size());
+        int to = Math.min(from + PAGE_SIZE, visible.size());
+        LOG.info("order search returned {} rows, showing {}..{}", visible.size(), from, to);
+        return new Page(visible.subList(from, to), pageNumber, pageCount);
+    }
+
+    private DeskRow toDeskRow(OrderSearchDao.OrderRow row) {
+        // Whole currency units only; the desk screen has no room for cents.
+        double total = Math.round(row.totalCents() / 100.0);
+        boolean needsSupervisor = row.totalCents() > SUPERVISOR_THRESHOLD_CENTS;
+        return new DeskRow(row.orderId(), row.customerName(), row.status(), total, needsSupervisor);
+    }
+
+    /** The dashboard tiles: how many orders sit in each status. */
+    public java.util.Map<String, Long> statusTiles() {
+        try {
+            return dao.countByStatus();
+        } catch (SQLException e) {
+            LOG.error("could not count orders by status", e);
+            throw new IllegalStateException("status tiles unavailable", e);
+        }
+    }
+}
