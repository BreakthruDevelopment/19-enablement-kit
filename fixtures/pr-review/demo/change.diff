+package com.harbor.oms.search;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+class OrderSearchServiceTest {
+
+    @Test
+    void firstPageHoldsAtMostOnePageOfRows() throws Exception {
+        OrderSearchService service = new OrderSearchService(new StubDao(30, "OPEN"));
+        OrderSearchService.Page page = service.search("harbor", null, false, 1);
+        assertEquals(25, page.rows().size());
+    }
+
+    @Test
+    void largeOrdersAreFlaggedForASupervisor() throws Exception {
+        OrderSearchService service = new OrderSearchService(new StubDao(1, "OPEN"));
+        OrderSearchService.Page page = service.search("harbor", null, false, 1);
+        assertTrue(page.rows().get(0).needsSupervisor());
+    }
+
+    private static final class StubDao extends OrderSearchDao {
+        private final int count;
+        private final String status;
+
+        StubDao(int count, String status) {
+            super(null);
+            this.count = count;
+            this.status = status;
+        }
+
+        @Override
+        public List<OrderRow> search(String nameFragment, String status) {
+            return java.util.stream.IntStream.range(0, count)
+                    .mapToObj(i -> new OrderRow(i, "Harbor Freight", this.status, 600_000L))
+                    .toList();
+        }
+    }
+}
