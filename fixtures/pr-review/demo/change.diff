@@ -0,0 +1,35 @@
+package com.harbor.oms.search;
+
+import jakarta.ws.rs.DefaultValue;
+import jakarta.ws.rs.GET;
+import jakarta.ws.rs.Path;
+import jakarta.ws.rs.Produces;
+import jakarta.ws.rs.QueryParam;
+import jakarta.ws.rs.core.MediaType;
+
+/** REST face of the order search, used by the service desk screen. */
+@Path("/orders/search")
+@Produces(MediaType.APPLICATION_JSON)
+public class OrderSearchResource {
+
+    private final OrderSearchService service;
+
+    public OrderSearchResource(OrderSearchService service) {
+        this.service = service;
+    }
+
+    @GET
+    public OrderSearchService.Page search(
+            @QueryParam("q") @DefaultValue("") String query,
+            @QueryParam("status") String status,
+            @QueryParam("includeCancelled") @DefaultValue("false") boolean includeCancelled,
+            @QueryParam("page") @DefaultValue("1") int page) {
+        return service.search(query, status, includeCancelled, page);
+    }
+
+    @GET
+    @Path("/tiles")
+    public java.util.Map<String, Long> tiles() {
+        return service.statusTiles();
+    }
+}
