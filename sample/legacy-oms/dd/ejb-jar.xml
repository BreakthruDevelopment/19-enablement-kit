<?xml version="1.0" encoding="UTF-8"?>
<!-- EJB 2.0 deployment descriptor for Harbor OMS. -->
<ejb-jar>
  <enterprise-beans>
    <session>
      <description>Places, cancels and looks up desk orders for an active buyer.</description>
      <display-name>OrderService</display-name>
      <ejb-name>OrderService</ejb-name>
      <home>com.harbor.oms.order.OrderServiceHome</home>
      <remote>com.harbor.oms.order.OrderService</remote>
      <ejb-class>com.harbor.oms.order.OrderServiceBean</ejb-class>
      <session-type>Stateless</session-type>
      <transaction-type>Container</transaction-type>
      <ejb-ref>
        <ejb-ref-name>ejb/Customer</ejb-ref-name>
        <ejb-ref-type>Entity</ejb-ref-type>
        <home>com.harbor.oms.customer.CustomerHome</home>
        <remote>com.harbor.oms.customer.Customer</remote>
      </ejb-ref>
      <ejb-ref>
        <ejb-ref-name>ejb/Product</ejb-ref-name>
        <ejb-ref-type>Entity</ejb-ref-type>
        <home>com.harbor.oms.product.ProductHome</home>
        <remote>com.harbor.oms.product.Product</remote>
      </ejb-ref>
      <ejb-ref>
        <ejb-ref-name>ejb/SalesOrder</ejb-ref-name>
        <ejb-ref-type>Entity</ejb-ref-type>
        <home>com.harbor.oms.order.SalesOrderHome</home>
        <remote>com.harbor.oms.order.SalesOrder</remote>
      </ejb-ref>
      <resource-ref>
        <res-ref-name>jdbc/OrderDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
      </resource-ref>
    </session>
    <session>
      <description>On-hand quantity, reservations and the reorder list for one warehouse.</description>
      <display-name>InventoryService</display-name>
      <ejb-name>InventoryService</ejb-name>
      <home>com.harbor.oms.inventory.InventoryServiceHome</home>
      <remote>com.harbor.oms.inventory.InventoryService</remote>
      <ejb-class>com.harbor.oms.inventory.InventoryServiceBean</ejb-class>
      <session-type>Stateless</session-type>
      <transaction-type>Container</transaction-type>
      <ejb-ref>
        <ejb-ref-name>ejb/Product</ejb-ref-name>
        <ejb-ref-type>Entity</ejb-ref-type>
        <home>com.harbor.oms.product.ProductHome</home>
        <remote>com.harbor.oms.product.Product</remote>
      </ejb-ref>
      <resource-ref>
        <res-ref-name>jdbc/OrderDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
      </resource-ref>
    </session>
    <session>
      <description>Region quotes from the product book, and buyer-approved price overrides.</description>
      <display-name>PricingService</display-name>
      <ejb-name>PricingService</ejb-name>
      <home>com.harbor.oms.pricing.PricingServiceHome</home>
      <remote>com.harbor.oms.pricing.PricingService</remote>
      <ejb-class>com.harbor.oms.pricing.PricingServiceBean</ejb-class>
      <session-type>Stateless</session-type>
      <transaction-type>Container</transaction-type>
      <ejb-ref>
        <ejb-ref-name>ejb/Product</ejb-ref-name>
        <ejb-ref-type>Entity</ejb-ref-type>
        <home>com.harbor.oms.product.ProductHome</home>
        <remote>com.harbor.oms.product.Product</remote>
      </ejb-ref>
      <resource-ref>
        <res-ref-name>jdbc/OrderDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
      </resource-ref>
    </session>
    <session>
      <description>Stages a shipment, marks it shipped and records delivery at the dock.</description>
      <display-name>FulfillmentService</display-name>
      <ejb-name>FulfillmentService</ejb-name>
      <home>com.harbor.oms.fulfillment.FulfillmentServiceHome</home>
      <remote>com.harbor.oms.fulfillment.FulfillmentService</remote>
      <ejb-class>com.harbor.oms.fulfillment.FulfillmentServiceBean</ejb-class>
      <session-type>Stateless</session-type>
      <transaction-type>Container</transaction-type>
      <ejb-ref>
        <ejb-ref-name>ejb/SalesOrder</ejb-ref-name>
        <ejb-ref-type>Entity</ejb-ref-type>
        <home>com.harbor.oms.order.SalesOrderHome</home>
        <remote>com.harbor.oms.order.SalesOrder</remote>
      </ejb-ref>
      <ejb-ref>
        <ejb-ref-name>ejb/Shipment</ejb-ref-name>
