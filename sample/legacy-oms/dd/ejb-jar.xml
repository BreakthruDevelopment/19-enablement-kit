        <remote>com.harbor.oms.shipment.Shipment</remote>
      </ejb-ref>
      <resource-ref>
        <res-ref-name>jdbc/OrderDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
      </resource-ref>
    </session>
    <session>
      <description>Adds skus, retires them and moves a sku between warehouses.</description>
      <display-name>CatalogAdmin</display-name>
      <ejb-name>CatalogAdmin</ejb-name>
      <home>com.harbor.oms.catalog.CatalogAdminHome</home>
      <remote>com.harbor.oms.catalog.CatalogAdmin</remote>
      <ejb-class>com.harbor.oms.catalog.CatalogAdminBean</ejb-class>
      <session-type>Stateless</session-type>
      <transaction-type>Container</transaction-type>
      <ejb-ref>
        <ejb-ref-name>ejb/Product</ejb-ref-name>
        <ejb-ref-type>Entity</ejb-ref-type>
        <home>com.harbor.oms.product.ProductHome</home>
        <remote>com.harbor.oms.product.Product</remote>
      </ejb-ref>
      <resource-ref>
        <res-ref-name>jdbc/OrderDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
      </resource-ref>
    </session>
    <entity>
      <description>A buyer the order desk can sell to. Credit and hold status live on this row.</description>
      <display-name>Customer</display-name>
      <ejb-name>Customer</ejb-name>
      <home>com.harbor.oms.customer.CustomerHome</home>
      <remote>com.harbor.oms.customer.Customer</remote>
      <ejb-class>com.harbor.oms.customer.CustomerBean</ejb-class>
      <persistence-type>Bean</persistence-type>
      <prim-key-class>java.lang.String</prim-key-class>
      <reentrant>False</reentrant>
      <resource-ref>
        <res-ref-name>jdbc/OrderDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
      </resource-ref>
    </entity>
    <entity>
      <description>A sku stocked in one warehouse. The desk reserves quantity off on_hand.</description>
      <display-name>Product</display-name>
      <ejb-name>Product</ejb-name>
      <home>com.harbor.oms.product.ProductHome</home>
      <remote>com.harbor.oms.product.Product</remote>
      <ejb-class>com.harbor.oms.product.ProductBean</ejb-class>
      <persistence-type>Bean</persistence-type>
      <prim-key-class>java.lang.String</prim-key-class>
      <reentrant>False</reentrant>
      <resource-ref>
        <res-ref-name>jdbc/OrderDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
      </resource-ref>
    </entity>
    <entity>
      <description>One desk order for one sku. The line row is written with the order.</description>
      <display-name>SalesOrder</display-name>
      <ejb-name>SalesOrder</ejb-name>
      <home>com.harbor.oms.order.SalesOrderHome</home>
      <remote>com.harbor.oms.order.SalesOrder</remote>
      <ejb-class>com.harbor.oms.order.SalesOrderBean</ejb-class>
      <persistence-type>Bean</persistence-type>
      <prim-key-class>java.lang.String</prim-key-class>
      <reentrant>False</reentrant>
      <resource-ref>
        <res-ref-name>jdbc/OrderDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
      </resource-ref>
    </entity>
    <entity>
      <description>A dock shipment against one order, from staged through delivered.</description>
      <display-name>Shipment</display-name>
      <ejb-name>Shipment</ejb-name>
      <home>com.harbor.oms.shipment.ShipmentHome</home>
      <remote>com.harbor.oms.shipment.Shipment</remote>
      <ejb-class>com.harbor.oms.shipment.ShipmentBean</ejb-class>
      <persistence-type>Bean</persistence-type>
      <prim-key-class>java.lang.String</prim-key-class>
      <reentrant>False</reentrant>
      <resource-ref>
        <res-ref-name>jdbc/OrderDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
      </resource-ref>
    </entity>
  </enterprise-beans>
