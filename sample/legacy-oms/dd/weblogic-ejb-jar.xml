<?xml version="1.0" encoding="UTF-8"?>
<!-- WebLogic bindings for Harbor OMS. The container is not run from this repo. -->
<weblogic-ejb-jar xmlns="http://www.bea.com/ns/weblogic/90">
  <weblogic-enterprise-bean>
    <ejb-name>OrderService</ejb-name>
    <stateless-session-descriptor>
      <pool>
        <max-beans-in-free-pool>30</max-beans-in-free-pool>
      </pool>
    </stateless-session-descriptor>
    <transaction-descriptor>
      <trans-timeout-seconds>60</trans-timeout-seconds>
    </transaction-descriptor>
    <jndi-name>ejb/harbor/OrderService</jndi-name>
    <resource-description>
      <res-ref-name>jdbc/OrderDS</res-ref-name>
      <jndi-name>jdbc/HarborOrderDS</jndi-name>
    </resource-description>
    <ejb-reference-description>
      <ejb-ref-name>ejb/Customer</ejb-ref-name>
      <jndi-name>ejb/harbor/Customer</jndi-name>
    </ejb-reference-description>
    <ejb-reference-description>
      <ejb-ref-name>ejb/Product</ejb-ref-name>
      <jndi-name>ejb/harbor/Product</jndi-name>
    </ejb-reference-description>
    <ejb-reference-description>
      <ejb-ref-name>ejb/SalesOrder</ejb-ref-name>
      <jndi-name>ejb/harbor/SalesOrder</jndi-name>
    </ejb-reference-description>
  </weblogic-enterprise-bean>
  <weblogic-enterprise-bean>
    <ejb-name>InventoryService</ejb-name>
    <stateless-session-descriptor>
      <pool>
        <max-beans-in-free-pool>20</max-beans-in-free-pool>
      </pool>
    </stateless-session-descriptor>
    <transaction-descriptor>
      <trans-timeout-seconds>60</trans-timeout-seconds>
    </transaction-descriptor>
    <jndi-name>ejb/harbor/InventoryService</jndi-name>
    <resource-description>
      <res-ref-name>jdbc/OrderDS</res-ref-name>
      <jndi-name>jdbc/HarborOrderDS</jndi-name>
    </resource-description>
    <ejb-reference-description>
      <ejb-ref-name>ejb/Product</ejb-ref-name>
      <jndi-name>ejb/harbor/Product</jndi-name>
    </ejb-reference-description>
  </weblogic-enterprise-bean>
  <weblogic-enterprise-bean>
    <ejb-name>PricingService</ejb-name>
    <stateless-session-descriptor>
      <pool>
        <max-beans-in-free-pool>15</max-beans-in-free-pool>
      </pool>
    </stateless-session-descriptor>
    <transaction-descriptor>
      <trans-timeout-seconds>60</trans-timeout-seconds>
    </transaction-descriptor>
    <jndi-name>ejb/harbor/PricingService</jndi-name>
    <resource-description>
      <res-ref-name>jdbc/OrderDS</res-ref-name>
      <jndi-name>jdbc/HarborOrderDS</jndi-name>
    </resource-description>
    <ejb-reference-description>
      <ejb-ref-name>ejb/Product</ejb-ref-name>
      <jndi-name>ejb/harbor/Product</jndi-name>
    </ejb-reference-description>
  </weblogic-enterprise-bean>
  <weblogic-enterprise-bean>
    <ejb-name>FulfillmentService</ejb-name>
    <stateless-session-descriptor>
      <pool>
        <max-beans-in-free-pool>20</max-beans-in-free-pool>
      </pool>
    </stateless-session-descriptor>
    <transaction-descriptor>
      <trans-timeout-seconds>60</trans-timeout-seconds>
    </transaction-descriptor>
    <jndi-name>ejb/harbor/FulfillmentService</jndi-name>
    <resource-description>
      <res-ref-name>jdbc/OrderDS</res-ref-name>
      <jndi-name>jdbc/HarborOrderDS</jndi-name>
    </resource-description>
    <ejb-reference-description>
      <ejb-ref-name>ejb/SalesOrder</ejb-ref-name>
      <jndi-name>ejb/harbor/SalesOrder</jndi-name>
    </ejb-reference-description>
    <ejb-reference-description>
      <ejb-ref-name>ejb/Shipment</ejb-ref-name>
      <jndi-name>ejb/harbor/Shipment</jndi-name>
    </ejb-reference-description>
  </weblogic-enterprise-bean>
  <weblogic-enterprise-bean>
    <ejb-name>CatalogAdmin</ejb-name>
    <stateless-session-descriptor>
      <pool>
        <max-beans-in-free-pool>10</max-beans-in-free-pool>
      </pool>
    </stateless-session-descriptor>
    <transaction-descriptor>
      <trans-timeout-seconds>60</trans-timeout-seconds>
    </transaction-descriptor>
    <jndi-name>ejb/harbor/CatalogAdmin</jndi-name>
    <resource-description>
      <res-ref-name>jdbc/OrderDS</res-ref-name>
      <jndi-name>jdbc/HarborOrderDS</jndi-name>
    </resource-description>
    <ejb-reference-description>
      <ejb-ref-name>ejb/Product</ejb-ref-name>
      <jndi-name>ejb/harbor/Product</jndi-name>
    </ejb-reference-description>
  </weblogic-enterprise-bean>
  <weblogic-enterprise-bean>
    <ejb-name>Customer</ejb-name>
    <entity-descriptor>
      <entity-cache>
        <max-beans-in-cache>200</max-beans-in-cache>
        <idle-timeout-seconds>600</idle-timeout-seconds>
      </entity-cache>
    </entity-descriptor>
    <transaction-descriptor>
      <trans-timeout-seconds>60</trans-timeout-seconds>
    </transaction-descriptor>
    <jndi-name>ejb/harbor/Customer</jndi-name>
    <resource-description>
      <res-ref-name>jdbc/OrderDS</res-ref-name>
      <jndi-name>jdbc/HarborOrderDS</jndi-name>
    </resource-description>
  </weblogic-enterprise-bean>
  <weblogic-enterprise-bean>
    <ejb-name>Product</ejb-name>
    <entity-descriptor>
      <entity-cache>
        <max-beans-in-cache>400</max-beans-in-cache>
        <idle-timeout-seconds>600</idle-timeout-seconds>
      </entity-cache>
    </entity-descriptor>
    <transaction-descriptor>
      <trans-timeout-seconds>60</trans-timeout-seconds>
    </transaction-descriptor>
    <jndi-name>ejb/harbor/Product</jndi-name>
    <resource-description>
      <res-ref-name>jdbc/OrderDS</res-ref-name>
      <jndi-name>jdbc/HarborOrderDS</jndi-name>
    </resource-description>
  </weblogic-enterprise-bean>
  <weblogic-enterprise-bean>
    <ejb-name>SalesOrder</ejb-name>
    <entity-descriptor>
      <entity-cache>
        <max-beans-in-cache>300</max-beans-in-cache>
        <idle-timeout-seconds>600</idle-timeout-seconds>
      </entity-cache>
    </entity-descriptor>
    <transaction-descriptor>
      <trans-timeout-seconds>60</trans-timeout-seconds>
    </transaction-descriptor>
    <jndi-name>ejb/harbor/SalesOrder</jndi-name>
    <resource-description>
      <res-ref-name>jdbc/OrderDS</res-ref-name>
      <jndi-name>jdbc/HarborOrderDS</jndi-name>
    </resource-description>
  </weblogic-enterprise-bean>
  <weblogic-enterprise-bean>
    <ejb-name>Shipment</ejb-name>
    <entity-descriptor>
      <entity-cache>
        <max-beans-in-cache>150</max-beans-in-cache>
        <idle-timeout-seconds>600</idle-timeout-seconds>
      </entity-cache>
    </entity-descriptor>
    <transaction-descriptor>
      <trans-timeout-seconds>60</trans-timeout-seconds>
    </transaction-descriptor>
    <jndi-name>ejb/harbor/Shipment</jndi-name>
    <resource-description>
      <res-ref-name>jdbc/OrderDS</res-ref-name>
      <jndi-name>jdbc/HarborOrderDS</jndi-name>
    </resource-description>
  </weblogic-enterprise-bean>
</weblogic-ejb-jar>
