<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/j2ee" version="2.4">
  <display-name>Harbor OMS</display-name>
  <servlet>
    <description>The desk form that places one order.</description>
    <servlet-name>OrderEntryServlet</servlet-name>
    <servlet-class>com.harbor.oms.web.OrderEntryServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>OrderEntryServlet</servlet-name>
    <url-pattern>/orders/new</url-pattern>
  </servlet-mapping>
  <servlet>
    <description>Looks up orders for a buyer and a status.</description>
    <servlet-name>OrderStatusServlet</servlet-name>
    <servlet-class>com.harbor.oms.web.OrderStatusServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>OrderStatusServlet</servlet-name>
    <url-pattern>/orders/status</url-pattern>
  </servlet-mapping>
  <servlet>
    <description>Browser post the warehouse office uses to save a sku.</description>
    <servlet-name>CatalogAdminServlet</servlet-name>
    <servlet-class>com.harbor.oms.catalog.CatalogAdminBean</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CatalogAdminServlet</servlet-name>
    <url-pattern>/admin/catalog</url-pattern>
  </servlet-mapping>
  <resource-ref>
    <res-ref-name>jdbc/OrderDS</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>
  <ejb-ref>
    <ejb-ref-name>ejb/OrderService</ejb-ref-name>
    <ejb-ref-type>Session</ejb-ref-type>
    <home>com.harbor.oms.order.OrderServiceHome</home>
    <remote>com.harbor.oms.order.OrderService</remote>
  </ejb-ref>
  <error-page>
    <exception-type>java.lang.Exception</exception-type>
    <location>/error.jsp</location>
  </error-page>
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>
</web-app>
